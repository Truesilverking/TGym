<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="48dp" android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="0dp" android:paddingBottom="0dp">
  <TextView android:id="@+id/accent_rail" android:layout_width="2dp" android:layout_height="32dp" android:layout_marginEnd="10dp" android:importantForAccessibility="no" />
  <LinearLayout android:id="@+id/rest_row" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/rest_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    <Chronometer android:id="@+id/rest_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textAppearance="@android:style/TextAppearance.Material.Notification" />
  </LinearLayout>
  <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
    <TextView android:id="@+id/workout_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="11sp" android:maxLines="1" android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    <Chronometer android:id="@+id/workout_clock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    <TextView android:id="@+id/workout_duration" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textSize="22sp" android:textStyle="bold" android:textAppearance="@android:style/TextAppearance.Material.Notification" />
  </LinearLayout>
  <TextView android:id="@+id/set_label" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:textSize="11sp" android:textStyle="bold" android:maxLines="1" android:textAppearance="@android:style/TextAppearance.Material.Notification" />
</LinearLayout>
